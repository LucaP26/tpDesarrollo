<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atelier_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="32dp"
        android:paddingEnd="30dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.22"
            android:text="ATELIER"
            android:textColor="@color/atelier_accent"
            android:textSize="34sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="28dp"
                android:layout_height="1dp"
                android:background="@color/atelier_text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="DESDE 1924"
                android:textAllCaps="true"
                android:textColor="@color/atelier_text_muted"
                android:textSize="10sp" />

            <View
                android:layout_width="28dp"
                android:layout_height="1dp"
                android:background="@color/atelier_text_muted" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:fontFamily="serif"
            android:text="Bienvenido de nuevo"
            android:textColor="@color/atelier_ink"
            android:textSize="34sp" />

        <TextView
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Entra a ATELIER, subastas exclusivas y coleccionables de alto valor."
            android:textColor="@color/atelier_text"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correo electronico"
                android:textAllCaps="true"
                android:textColor="@color/atelier_text_muted"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="curador@atelier.com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColor="@color/atelier_ink"
                android:textColorHint="@color/atelier_text_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Contrasena"
                    android:textAllCaps="true"
                    android:textColor="@color/atelier_text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/forgotButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Olvidaste?"
                    android:textAllCaps="true"
                    android:textColor="@color/atelier_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="********"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="@color/atelier_ink"
                android:textColorHint="@color/atelier_text_muted" />

            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_primary_button"
                android:text="Entrar a la plataforma"
                android:textAllCaps="true"
                android:textColor="#412D00"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/atelier_border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="Opciones de acceso"
                android:textAllCaps="true"
                android:textColor="@color/atelier_text_muted"
                android:textSize="10sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/atelier_border" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="No tenes una cuenta?"
            android:textColor="@color/atelier_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/registerButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_secondary_button"
            android:minWidth="148dp"
            android:paddingHorizontal="22dp"
            android:text="Registrarse"
            android:textAllCaps="true"
            android:textColor="@color/atelier_accent"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Politica de privacidad"
                android:textAllCaps="true"
                android:textColor="@color/atelier_text_muted"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:text="|"
                android:textColor="@color/atelier_text_muted"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terminos del servicio"
                android:textAllCaps="true"
                android:textColor="@color/atelier_text_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

