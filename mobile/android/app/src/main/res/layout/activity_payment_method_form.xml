<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atelier_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="42dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="&lt;"
            android:textColor="@color/atelier_text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.24"
            android:text="ATELIER"
            android:textColor="@color/atelier_accent"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:fontFamily="serif"
            android:text="Agregar medio\nde pago"
            android:textColor="@color/atelier_ink"
            android:textSize="40sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"
            android:text="Carga una tarjeta, cuenta bancaria o cheque para operar dentro de tu perfil."
            android:textColor="@color/atelier_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Medio de pago"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/paymentTypeValue"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_editorial_field"
            android:gravity="center_vertical"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Nombre del titular"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/holderFirstNameInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_editorial_field"
            android:hint="Nombre"
            android:inputType="textPersonName"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textColorHint="@color/atelier_surface_high"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Apellido del titular"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/holderLastNameInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_editorial_field"
            android:hint="Apellido"
            android:inputType="textPersonName"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textColorHint="@color/atelier_surface_high"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/currencyFieldGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Moneda"
                android:textAllCaps="true"
                android:textColor="@color/atelier_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/currencyValue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_editorial_field"
                android:gravity="center_vertical"
                android:paddingBottom="14dp"
                android:textColor="@color/atelier_ink"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bankFieldGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Banco emisor"
                android:textAllCaps="true"
                android:textColor="@color/atelier_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/bankValue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_editorial_field"
                android:gravity="center_vertical"
                android:paddingBottom="14dp"
                android:textColor="@color/atelier_ink"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardFieldsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Marca de la tarjeta"
                android:textAllCaps="true"
                android:textColor="@color/atelier_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/cardBrandValue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_editorial_field"
                android:gravity="center_vertical"
                android:paddingBottom="14dp"
                android:textColor="@color/atelier_ink"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Numero de tarjeta"
                android:textAllCaps="true"
                android:textColor="@color/atelier_text_muted"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/cardNumberInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_editorial_field"
                android:hint="16 digitos"
                android:inputType="number"
                android:paddingBottom="14dp"
                android:textColor="@color/atelier_ink"
                android:textColorHint="@color/atelier_surface_high"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Codigo de seguridad"
                android:textAllCaps="true"
                android:textColor="@color/atelier_text_muted"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/securityCodeInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_editorial_field"
                android:hint="3 digitos"
                android:inputType="number"
                android:paddingBottom="14dp"
                android:textColor="@color/atelier_ink"
                android:textColorHint="@color/atelier_surface_high"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Fecha de vencimiento"
                android:textAllCaps="true"
                android:textColor="@color/atelier_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/expirationDateValue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_editorial_field"
                android:gravity="center_vertical"
                android:paddingBottom="14dp"
                android:textColor="@color/atelier_ink"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/checkAmountGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Monto"
                android:textAllCaps="true"
                android:textColor="@color/atelier_text_muted"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/checkAmountInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_editorial_field"
                android:hint="Solo numeros"
                android:inputType="number"
                android:paddingBottom="14dp"
                android:textColor="@color/atelier_ink"
                android:textColorHint="@color/atelier_surface_high"
                android:textSize="18sp" />
        </LinearLayout>

        <Button
            android:id="@+id/submitButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_primary_button"
            android:text="Guardar medio de pago"
            android:textAllCaps="false"
            android:textColor="#412D00"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
