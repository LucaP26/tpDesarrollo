<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_footer_nav"
    android:elevation="16dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:id="@+id/footerHomeButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/footerHomeIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#8962;"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/footerHomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Home"
            android:textAllCaps="true"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footerDiscoverButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/footerDiscoverIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#9678;"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/footerDiscoverLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Discover"
            android:textAllCaps="true"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footerWatchlistButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/footerWatchlistIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#9825;"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/footerWatchlistLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Watchlist"
            android:textAllCaps="true"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footerBidsButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/footerBidsIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_hammer" />

        <TextView
            android:id="@+id/footerBidsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pujas"
            android:textAllCaps="true"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
