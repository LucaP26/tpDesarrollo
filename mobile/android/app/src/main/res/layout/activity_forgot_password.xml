<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/curator_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="&lt;"
        android:textColor="@color/curator_ink"
        android:textSize="24sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="serif"
        android:text="Recuperar contrasena"
        android:textColor="@color/curator_ink"
        android:textSize="32sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4dp"
        android:text="Ingresa el correo asociado a tu cuenta y te enviaremos un codigo de recuperacion."
        android:textColor="@color/curator_text"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Correo electronico"
        android:textAllCaps="true"
        android:textColor="@color/curator_text_muted"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/emailInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="tuemail@ejemplo.com"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="16dp"
        android:textColor="@color/curator_ink"
        android:textColorHint="@color/curator_text_muted" />

    <Button
        android:id="@+id/requestButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_primary_button"
        android:text="Enviar codigo"
        android:textAllCaps="true"
        android:textColor="#412D00"
        android:textSize="12sp" />
</LinearLayout>
