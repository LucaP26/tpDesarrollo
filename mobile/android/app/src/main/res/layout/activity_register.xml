<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/curator_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/curator_accent"
                android:textSize="24sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Registro"
                android:textColor="@color/curator_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="40dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Crear cuenta en CURATOR"
            android:textColor="@color/curator_ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:text="Completa tus datos, adjunta las fotos del DNI y deja cargado un medio de pago real para empezar a operar."
            android:textColor="@color/curator_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Datos personales"
            android:textAllCaps="true"
            android:textColor="@color/curator_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nombre"
            android:textAllCaps="true"
            android:textColor="@color/curator_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/firstNameInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Ej. Malena"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="@color/curator_ink"
            android:textColorHint="@color/curator_text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Apellido"
            android:textAllCaps="true"
            android:textColor="@color/curator_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/lastNameInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Ej. Garcia"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="@color/curator_ink"
            android:textColorHint="@color/curator_text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Correo electronico"
            android:textAllCaps="true"
            android:textColor="@color/curator_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="curador@curator.com"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="@color/curator_ink"
            android:textColorHint="@color/curator_text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Pais de origen"
            android:textAllCaps="true"
            android:textColor="@color/curator_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/countryValue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:textColor="@color/curator_ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Verificacion"
            android:textAllCaps="true"
            android:textColor="@color/curator_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/documentSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Debes cargar frente y dorso en PNG o JPG"
                android:textColor="@color/curator_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Pediremos acceso a tu galeria para seleccionar las dos imagenes del DNI."
                android:textColor="@color/curator_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/documentFrontButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_secondary_button"
                android:text="Cargar frente"
                android:textAllCaps="true"
                android:textColor="@color/curator_accent"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/documentFrontStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Frente pendiente"
                android:textColor="@color/curator_text_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/documentBackButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_secondary_button"
                android:text="Cargar dorso"
                android:textAllCaps="true"
                android:textColor="@color/curator_accent"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/documentBackStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Dorso pendiente"
                android:textColor="@color/curator_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Domicilio"
            android:textAllCaps="true"
            android:textColor="@color/curator_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Calle"
            android:textAllCaps="true"
            android:textColor="@color/curator_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/streetInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Avenida Libertador"
            android:inputType="textPostalAddress"
            android:paddingHorizontal="16dp"
            android:textColor="@color/curator_ink"
            android:textColorHint="@color/curator_text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Numero"
            android:textAllCaps="true"
            android:textColor="@color/curator_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/numberInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="1234"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:textColor="@color/curator_ink"
            android:textColorHint="@color/curator_text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ciudad"
            android:textAllCaps="true"
            android:textColor="@color/curator_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/cityInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Buenos Aires"
            android:inputType="textPostalAddress"
            android:paddingHorizontal="16dp"
            android:textColor="@color/curator_ink"
            android:textColorHint="@color/curator_text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Provincia / Region"
            android:textAllCaps="true"
            android:textColor="@color/curator_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/regionInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Buenos Aires"
            android:inputType="textPostalAddress"
            android:paddingHorizontal="16dp"
            android:textColor="@color/curator_ink"
            android:textColorHint="@color/curator_text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Codigo postal"
            android:textAllCaps="true"
            android:textColor="@color/curator_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/postalCodeInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="C1001"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="@color/curator_ink"
            android:textColorHint="@color/curator_text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Medio de pago"
            android:textAllCaps="true"
            android:textColor="@color/curator_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tipo"
            android:textAllCaps="true"
            android:textColor="@color/curator_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/paymentTypeValue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:textColor="@color/curator_ink"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/currencyFieldGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Moneda"
                android:textAllCaps="true"
                android:textColor="@color/curator_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/currencyValue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:textColor="@color/curator_ink"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bankFieldGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Banco emisor"
                android:textAllCaps="true"
                android:textColor="@color/curator_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/bankValue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:textColor="@color/curator_ink"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardFieldsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Numero de tarjeta"
                android:textAllCaps="true"
                android:textColor="@color/curator_text_muted"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/cardNumberInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="1234123412341234"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:textColor="@color/curator_ink"
                android:textColorHint="@color/curator_text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Codigo de seguridad"
                android:textAllCaps="true"
                android:textColor="@color/curator_text_muted"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/securityCodeInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="123"
                android:inputType="numberPassword"
                android:paddingHorizontal="16dp"
                android:textColor="@color/curator_ink"
                android:textColorHint="@color/curator_text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Fecha de vencimiento"
                android:textAllCaps="true"
                android:textColor="@color/curator_text_muted"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/expirationDateInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="MM/AA"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:textColor="@color/curator_ink"
                android:textColorHint="@color/curator_text_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/checkAmountGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Monto del cheque"
                android:textAllCaps="true"
                android:textColor="@color/curator_text_muted"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/checkAmountInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="150000"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:textColor="@color/curator_ink"
                android:textColorHint="@color/curator_text_muted" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Acceso"
            android:textAllCaps="true"
            android:textColor="@color/curator_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Contrasena"
            android:textAllCaps="true"
            android:textColor="@color/curator_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Minimo 6 caracteres"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="@color/curator_ink"
            android:textColorHint="@color/curator_text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Confirmar contrasena"
            android:textAllCaps="true"
            android:textColor="@color/curator_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/confirmPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Repite la contrasena"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="@color/curator_ink"
            android:textColorHint="@color/curator_text_muted" />

        <Button
            android:id="@+id/submitButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_primary_button"
            android:text="Crear cuenta"
            android:textAllCaps="true"
            android:textColor="#412D00"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Al registrarte, el medio de pago quedara pendiente de revision administrativa antes de habilitar las pujas."
            android:textColor="@color/curator_text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
