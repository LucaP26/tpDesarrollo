<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atelier_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="42dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="&lt;"
            android:textColor="@color/atelier_text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.24"
            android:text="ATELIER"
            android:textColor="@color/atelier_accent"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:fontFamily="serif"
            android:text="Crear tu\ncuenta"
            android:textColor="@color/atelier_ink"
            android:textSize="42sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"
            android:text="Sumate a un circulo exclusivo de coleccionistas y conocedores."
            android:textColor="@color/atelier_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Nombre"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/firstNameInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_editorial_field"
            android:hint="Ingresa tu nombre"
            android:inputType="textPersonName"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textColorHint="@color/atelier_surface_high"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Apellido"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/lastNameInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_editorial_field"
            android:hint="Ingresa tu apellido"
            android:inputType="textPersonName"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textColorHint="@color/atelier_surface_high"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Genero"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/genderValue"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_editorial_field"
            android:gravity="center_vertical"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Correo electronico"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_editorial_field"
            android:hint="tu@email.com"
            android:inputType="textEmailAddress"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textColorHint="@color/atelier_surface_high"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Numero de documento"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/documentNumberInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_editorial_field"
            android:hint="DNI, pasaporte o documento"
            android:inputType="text"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textColorHint="@color/atelier_surface_high"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Fecha de nacimiento"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/birthDateValue"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_editorial_field"
            android:gravity="center_vertical"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Pais de origen"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/countryValue"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_editorial_field"
            android:gravity="center_vertical"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Documento de identidad"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/documentSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="Debes cargar frente y dorso del DNI en PNG o JPG"
            android:textColor="@color/atelier_text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/documentFrontButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_secondary_button"
            android:text="Cargar frente del DNI"
            android:textAllCaps="true"
            android:textColor="@color/atelier_accent"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/documentFrontStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Frente pendiente"
            android:textColor="@color/atelier_text_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/documentBackButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_secondary_button"
            android:text="Cargar dorso del DNI"
            android:textAllCaps="true"
            android:textColor="@color/atelier_accent"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/documentBackStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Dorso pendiente"
            android:textColor="@color/atelier_text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Domicilio legal"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/streetInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_editorial_field"
            android:hint="Calle"
            android:inputType="textPostalAddress"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textColorHint="@color/atelier_surface_high"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/numberInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_editorial_field"
            android:hint="Numero"
            android:inputType="number"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textColorHint="@color/atelier_surface_high"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/cityInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_editorial_field"
            android:hint="Ciudad"
            android:inputType="textPostalAddress"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textColorHint="@color/atelier_surface_high"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/regionInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_editorial_field"
            android:hint="Provincia o region"
            android:inputType="textPostalAddress"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textColorHint="@color/atelier_surface_high"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/postalCodeInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_editorial_field"
            android:hint="Codigo postal"
            android:inputType="text"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textColorHint="@color/atelier_surface_high"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Medio de pago"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/paymentTypeValue"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_editorial_field"
            android:gravity="center_vertical"
            android:paddingBottom="14dp"
            android:textColor="@color/atelier_ink"
            android:textSize="18sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/currencyFieldGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/currencyValue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_editorial_field"
                android:gravity="center_vertical"
                android:paddingBottom="14dp"
                android:textColor="@color/atelier_ink"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bankFieldGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/bankValue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_editorial_field"
                android:gravity="center_vertical"
                android:paddingBottom="14dp"
                android:textColor="@color/atelier_ink"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardFieldsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/cardBrandValue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_editorial_field"
                android:gravity="center_vertical"
                android:paddingBottom="14dp"
                android:textColor="@color/atelier_ink"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/cardNumberInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_editorial_field"
                android:hint="Numero de tarjeta"
                android:inputType="number"
                android:paddingBottom="14dp"
                android:textColor="@color/atelier_ink"
                android:textColorHint="@color/atelier_surface_high"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/securityCodeInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_editorial_field"
                android:hint="Codigo de seguridad"
                android:inputType="numberPassword"
                android:paddingBottom="14dp"
                android:textColor="@color/atelier_ink"
                android:textColorHint="@color/atelier_surface_high"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/expirationDateInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_editorial_field"
                android:gravity="center_vertical"
                android:paddingBottom="14dp"
                android:textColor="@color/atelier_ink"
                android:textColorHint="@color/atelier_surface_high"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/checkAmountGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/checkAmountInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_editorial_field"
                android:hint="Monto del cheque"
                android:inputType="number"
                android:paddingBottom="14dp"
                android:textColor="@color/atelier_ink"
                android:textColorHint="@color/atelier_surface_high"
                android:textSize="18sp" />
        </LinearLayout>

        <Button
            android:id="@+id/submitButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_primary_button"
            android:text="Continuar"
            android:textAllCaps="true"
            android:textColor="#412D00"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Si todo esta correcto, la empresa revisara tu solicitud y te enviara el acceso para generar tu contrasena personal."
            android:textColor="@color/atelier_text"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

