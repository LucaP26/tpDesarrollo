<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atelier_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp">

            <ImageView
                android:id="@+id/topSearchButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:adjustViewBounds="true"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home_bell" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:gravity="center"
                android:letterSpacing="0.16"
                android:text="ATELIER"
                android:textAllCaps="true"
                android:textColor="@color/atelier_accent"
                android:textSize="22sp" />

            <FrameLayout
                android:id="@+id/topProfileButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_ring"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/topProfileAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_inner"
                    android:scaleType="centerCrop" />
            </FrameLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="120dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="740dp">

                    <ImageView
                        android:id="@+id/heroImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_hero_gradient" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:paddingStart="28dp"
                        android:paddingTop="56dp"
                        android:paddingEnd="28dp"
                        android:paddingBottom="42dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SUBASTA EN VIVO &#8226; LOTE 158"
                            android:textAllCaps="true"
                            android:textColor="@color/atelier_accent"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="serif"
                            android:lineSpacingExtra="4dp"
                            android:text="Patek Philippe Referencia 1518"
                            android:textColor="@color/atelier_ink"
                            android:textSize="44sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="PUJA ACTUAL"
                                    android:textAllCaps="true"
                                    android:textColor="@color/atelier_text_muted"
                                    android:textSize="10sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="serif"
                                    android:text="$12,450,000"
                                    android:textColor="@color/atelier_accent"
                                    android:textSize="28sp" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="48dp"
                                android:background="@color/atelier_border" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="18dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="CIERRA EN"
                                    android:textAllCaps="true"
                                    android:textColor="@color/atelier_text_muted"
                                    android:textSize="10sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="serif"
                                    android:text="04:22:15"
                                    android:textColor="@color/atelier_ink"
                                    android:textSize="28sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <Button
                            android:id="@+id/heroPrimaryButton"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:layout_marginTop="28dp"
                            android:background="@drawable/bg_primary_button"
                            android:minWidth="176dp"
                            android:paddingStart="26dp"
                            android:paddingEnd="26dp"
                            android:text="Pujar"
                            android:textAllCaps="true"
                            android:textColor="#412D00"
                            android:textSize="12sp" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="28dp"
                    android:text="Categorias"
                    android:textAllCaps="true"
                    android:textColor="@color/atelier_text_muted"
                    android:textSize="11sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/departmentsRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginEnd="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cierran pronto"
                        android:textAllCaps="true"
                        android:textColor="@color/atelier_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/viewAllButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver todo"
                        android:textAllCaps="true"
                        android:textColor="@color/atelier_accent"
                        android:textSize="11sp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/closingSoonRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp" />
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="34dp"
                    android:text="Colecciones destacadas"
                    android:textAllCaps="true"
                    android:textColor="@color/atelier_text_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/featuredCollectionsColumn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@color/atelier_surface_soft"
                    android:orientation="vertical"
                    android:paddingTop="22dp"
                    android:paddingBottom="28dp">

                    <ImageView
                        android:id="@+id/editorialImage"
                        android:layout_width="match_parent"
                        android:layout_height="400dp"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="22dp"
                        android:paddingTop="28dp"
                        android:paddingEnd="22dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="La mirada curada"
                            android:textAllCaps="true"
                            android:textColor="@color/atelier_accent"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="serif"
                            android:lineSpacingExtra="3dp"
                            android:text="Mas alla del martillo: el arte de coleccionar"
                            android:textColor="@color/atelier_ink"
                            android:textSize="34sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:lineSpacingExtra="6dp"
                            android:text="Coleccionar es mucho mas que poseer. Explora nuestra ultima editorial sobre el panorama cambiante de los activos excepcionales y las adquisiciones privadas."
                            android:textColor="@color/atelier_text"
                            android:textSize="16sp" />

                        <Button
                            android:id="@+id/editorialButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="24dp"
                            android:background="@drawable/bg_secondary_button"
                            android:minWidth="184dp"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:text="Leer editorial"
                            android:textAllCaps="true"
                            android:textColor="@color/atelier_accent"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_footer_nav"
        android:elevation="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/footerHomeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_footer_nav_active"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8962;"
                android:textColor="@color/atelier_accent"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Home"
                android:textAllCaps="true"
                android:textColor="@color/atelier_accent"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/footerDiscoverButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#9678;"
                android:textColor="@color/atelier_text"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Discover"
                android:textAllCaps="true"
                android:textColor="@color/atelier_text"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/footerWatchlistButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#9825;"
                android:textColor="@color/atelier_text"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Watchlist"
                android:textAllCaps="true"
                android:textColor="@color/atelier_text"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/footerBidsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_hammer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pujas"
                android:textAllCaps="true"
                android:textColor="@color/atelier_text"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
