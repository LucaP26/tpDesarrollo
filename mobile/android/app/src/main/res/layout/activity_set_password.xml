<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atelier_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="&lt;"
            android:textColor="@color/atelier_text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.24"
            android:text="ATELIER"
            android:textColor="@color/atelier_accent"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:fontFamily="serif"
            android:text="Crea tu\ncontrasena"
            android:textColor="@color/atelier_ink"
            android:textSize="40sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"
            android:text="Tu correo ya fue validado. Define ahora una contrasena privada para activar tu acceso a Atelier."
            android:textColor="@color/atelier_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Correo asociado"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/emailValue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:textColor="@color/atelier_ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Contrasena"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Minimo 6 caracteres"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="@color/atelier_ink"
            android:textColorHint="@color/atelier_text_muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="Debe incluir una minuscula, una mayuscula, un numero y un simbolo."
            android:textColor="@color/atelier_text"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Confirmar contrasena"
            android:textAllCaps="true"
            android:textColor="@color/atelier_text_muted"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/confirmPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Repite tu contrasena"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="@color/atelier_ink"
            android:textColorHint="@color/atelier_text_muted" />

        <Button
            android:id="@+id/submitButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="34dp"
            android:background="@drawable/bg_primary_button"
            android:text="Crear contrasena"
            android:textAllCaps="true"
            android:textColor="#412D00"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

