<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="18dp"
    android:background="@drawable/bg_card_surface"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/lotImage"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:adjustViewBounds="true"
        android:background="@color/atelier_surface_soft"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/atelier_surface_muted"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_primary_button"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="En vivo"
            android:textAllCaps="true"
            android:textColor="#412D00"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pieceNumberText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/atelier_text_muted"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lotTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="serif"
            android:textColor="@color/atelier_ink"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/lotDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/atelier_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/lotMetaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/atelier_text_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lotStoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/atelier_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/priceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="serif"
            android:textColor="@color/atelier_accent"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/currentBidText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/atelier_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/bidHistoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/atelier_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/timerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip_surface"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="@color/atelier_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <EditText
            android:id="@+id/bidInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:hint="Ingresa tu puja"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp"
            android:textColor="@color/atelier_ink"
            android:textColorHint="@color/atelier_text_muted" />

        <Button
            android:id="@+id/paymentSelectorButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_secondary_button"
            android:text="Seleccionar medio de pago"
            android:textAllCaps="true"
            android:textColor="@color/atelier_accent"
            android:textSize="11sp" />

        <Button
            android:id="@+id/bidButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_primary_button"
            android:text="Pujar"
            android:textAllCaps="true"
            android:textColor="#412D00"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

