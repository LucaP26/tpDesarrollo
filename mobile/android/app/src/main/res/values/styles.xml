<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    <item name="colorPrimary">@color/curator_accent</item>
    <item name="android:statusBarColor">@color/curator_background</item>
    <item name="android:navigationBarColor">@color/curator_background</item>
    <item name="android:windowBackground">@color/curator_background</item>
    <item name="android:textColor">@color/curator_ink</item>
  </style>
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowBackground">@drawable/launch_screen</item>
  </style>
</resources>
